# Git
.git
.gitignore

# Environment variables & secrets
.env
.env.*
!.env.example

# Python virtual environment
.venv/
venv/
env/
ENV/

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Local databases & user data artifacts (persisted via Docker volumes)
data/*.db
data/documents/*
data/vector_store/*
!data/.gitkeep

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
